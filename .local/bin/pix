#!/usr/bin/env bash
# Run the `pi` docker image (see .docker/template/pi/build_sandbox_template.sh)
# with the current directory mounted. Reuses the container if it already exists.
set -e

NAME="pi-$(basename "$PWD")-$(echo -n "$PWD" | cksum | cut -d' ' -f1)"

if docker container inspect "$NAME" >/dev/null 2>&1; then
  exec docker start -ai "$NAME"
fi

# Shadow these folders in the workspace with volumes owned by agent
# (anonymous volumes are root-owned)
SHADOW_DIRS=(node_modules)
VOL_ARGS=()
while IFS= read -r dir; do
  VOL="$NAME-nm-$(echo -n "$dir" | cksum | cut -d' ' -f1)"
  if ! docker volume inspect "$VOL" >/dev/null 2>&1; then
    docker volume create "$VOL" >/dev/null
    docker run --rm -u root --entrypoint chown -v "$VOL:/v" pi agent:agent /v
  fi
  VOL_ARGS+=(-v "$VOL:/workspace${dir#.}")
done < <(find . \( $(printf -- '-name %s -o ' "${SHADOW_DIRS[@]}" | sed 's/ -o $//') \) -type d -prune)

exec docker run -it --name "$NAME" \
  -v "$PWD:/workspace" -w /workspace \
  -v "$HOME/.pi/agent/auth.json:/home/agent/.pi/agent/auth.json" \
  "${VOL_ARGS[@]}" \
  pi "$@"
