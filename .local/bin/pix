#!/usr/bin/env bash
# Run the `pi` docker image (see .docker/template/pi/build_sandbox_template.sh)
# with the current directory mounted. Reuses the container if it already exists,
# starting a fresh pi session in it rather than attaching to the running one.
#
# Remove all containers/volumes created by this script:
#   docker rm -f $(docker ps -aq --filter name='^pi-') 2>/dev/null
#   docker volume rm $(docker volume ls -q --filter name='^pi-') 2>/dev/null
#
# --- Editing the sandbox from VS Code / Zed -----------------------------------
# Container name is printed by: docker ps --filter name='^pi-'
#
# VS Code (simplest, no setup): Dev Containers extension ->
#   "Dev Containers: Attach to Running Container..." -> pick pi-<dir>-<hash>.
#
# Zed (needs SSH): add once to ~/.ssh/config --
#   Host pi-*
#     User agent
#     ProxyCommand docker exec -i -u root %h sshd-stdio
#     StrictHostKeyChecking no
#     UserKnownHostsFile /dev/null
# then `zed ssh://pi-<dir>-<hash>/workspace`, or Zed -> "Project: Open Remote"
# -> add host `pi-<dir>-<hash>` -> open /workspace.
# Same config makes plain `ssh pi-<dir>-<hash>` and VS Code Remote-SSH work.
#
# sshd runs over `docker exec` stdio, so no port is published and no SSH key is
# needed -- entry is already gated by docker socket access.
set -e

NAME="pi-$(basename "$PWD")-$(echo -n "$PWD" | cksum | cut -d' ' -f1)"

if docker container inspect "$NAME" >/dev/null 2>&1; then
  docker start "$NAME" >/dev/null
  exec docker exec -it -w /workspace "$NAME" pi "$@"
fi

# Shadow these folders in the workspace with volumes owned by agent
# (anonymous volumes are root-owned)
SHADOW_DIRS=(node_modules)
VOL_ARGS=()
while IFS= read -r dir; do
  SLUG=$(basename "$dir")
  SLUG=${SLUG//[^[:alnum:]_.-]/-}
  HASH=$(echo -n "$dir" | cksum | cut -d' ' -f1)
  VOL="$NAME-$SLUG-$HASH"
  if ! docker volume inspect "$VOL" >/dev/null 2>&1; then
    docker volume create "$VOL" >/dev/null
    docker run --rm -u root --entrypoint chown -v "$VOL:/v" pi agent:agent /v
  fi
  VOL_ARGS+=(-v "$VOL:/workspace${dir#.}")
done < <(find . \( $(printf -- '-name %s -o ' "${SHADOW_DIRS[@]}" | sed 's/ -o $//') \) -type d -prune)

exec docker run -it --name "$NAME" \
  -v "$PWD:/workspace" -w /workspace \
  -v "$HOME/.pi/agent/auth.json:/home/agent/.pi/agent/auth.json" \
  "${VOL_ARGS[@]}" \
  pi "$@"
