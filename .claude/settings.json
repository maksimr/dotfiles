{
  "env": {
    "DISABLE_TELEMETRY": "1"
  },
  "apiKeyHelper": "cat ~/.cli-proxy-api/client.key 2>/dev/null || security find-generic-password -s cliproxyapi-client -w",
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git remote -v)",
      "Bash(git stash list)",
      "Bash(git blame *)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(file *)",
      "Bash(wc *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(ps *)",
      "Bash(tree *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(uname *)",
      "Bash(date)",
      "Bash(jq *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(npm:*)",
      "Bash(uv init *)",
      "Bash(uv add *)",
      "Bash(uv run *)",
      "Edit(//tmp/**)",
      "Edit(//private/tmp/**)"
    ],
    "deny": [
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(rm -rf *)",
      "Bash(git push *)",
      "Bash(sudo *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./.ssh/**)",
      "Edit(//System/**)",
      "Edit(//Library/**)",
      "Edit(//private/etc/**)",
      "Edit(//private/var/**)",
      "Edit(//usr/**)",
      "Edit(//bin/**)",
      "Edit(//sbin/**)",
      "Edit(//etc/**)",
      "Edit(//var/**)",
      "Edit(//Users/*/Library/**)",
      "Edit(//boot/**)",
      "Edit(//proc/**)",
      "Edit(//sys/**)",
      "Edit(//dev/**)",
      "Edit(//root/**)",
      "Edit(//run/**)",
      "Edit(//lib/**)",
      "Edit(//lib64/**)",
      "Edit(//opt/**)",
      "Edit(//srv/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true
  },
  "effortLevel": "high",
  "promptCacheTtl": "1h",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "theme": "dark-ansi",
  "remoteControlAtStartup": true
}
